# =============================================================================
# Epslionic Agent - Environment Configuration
# Copy this to .env and fill in your values
# =============================================================================

# API Keys
OPENAI_API_KEY=sk-...                    # OpenAI API key for LLM Brain
ANTHROPIC_API_KEY=sk-ant-...              # Anthropic API key (optional)
HF_TOKEN=hf_...                           # HuggingFace token for dataset access
WANDB_API_KEY=...                         # Weights & Biases token (optional)

# Agent Configuration
LOG_LEVEL=INFO                            # DEBUG, INFO, WARNING, ERROR
DEFAULT_DOMAIN=general                    # Default domain: math, code, medical, etc.
HEARTBEAT_INTERVAL=60                     # Heartbeat check interval in seconds
MAX_RETRIES=3                             # Max retries on training errors

# Training Defaults
MODEL_NAME=unsloth/mistral-7b-bnb-4bit
BATCH_SIZE=2
LEARNING_RATE=0.0002
NUM_EPOCHS=3
MAX_SEQ_LENGTH=2048
LORA_R=16

# Server
DASHBOARD_PORT=7860
API_PORT=8000
API_HOST=0.0.0.0

# Paths
WORKSPACE_ROOT=./data
CONFIG_PATH=./config/epsionic.yaml
